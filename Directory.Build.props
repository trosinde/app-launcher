<Project>
  <!-- Shared settings for all AppStart projects. Build and run on Windows; EnableWindowsTargeting allows compiling elsewhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>AppStart</Company>
    <Product>AppStart</Product>
    <Version>0.1.0</Version>
    <NeutralLanguage>de-CH</NeutralLanguage>
    <!-- AppStart icon (spec fix-wizard-findings «Eigenes Icon»); source and generator in assets/icon. -->
    <AppStartIcon>$(MSBuildThisFileDirectory)assets\icon\AppStart.ico</AppStartIcon>
  </PropertyGroup>
</Project>
