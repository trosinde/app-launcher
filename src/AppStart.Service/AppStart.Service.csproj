<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Windows service (LocalSystem): accepts START requests on \\.\pipe\AppStart and launches released apps. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>AppStart Service</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.15" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppStart.Core\AppStart.Core.csproj" />
    <InternalsVisibleTo Include="AppStart.Service.Tests" />
  </ItemGroup>

</Project>
