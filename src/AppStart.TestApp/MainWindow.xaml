<Window x:Class="AppStart.TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppStart.TestApp"
        xmlns:vm="clr-namespace:AppStart.TestApp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{x:Static local:Texts.WindowTitle}"
        Icon="Assets/TestApp.ico"
        Width="720" Height="600" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}">

  <Grid Margin="26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Heading -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{x:Static local:Texts.Heading}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{x:Static local:Texts.SubHeading}" FontSize="13" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}" />
    </StackPanel>

    <!-- Status list -->
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="State">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:StatusRow}">
            <Border x:Name="RowBorder" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="14,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" MinWidth="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" Margin="0,0,10,0" />
                <Border Grid.Column="2" Style="{StaticResource Badge}" AutomationProperties.Name="{Binding Badge}">
                  <TextBlock Text="{Binding Badge}" Style="{StaticResource BadgeText}" />
                </Border>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                <Setter TargetName="RowBorder" Property="BorderThickness" Value="0" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Test value -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,12">
      <StackPanel>
        <Label Content="{x:Static local:Texts.TestValueLabel}" Target="{Binding ElementName=TestValueBox}"
               FontSize="13" FontWeight="SemiBold" Padding="0" Margin="0,0,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TestValueBox" Text="{Binding TestValue, UpdateSourceTrigger=PropertyChanged}" FontSize="13" VerticalContentAlignment="Center" />
          <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                  Content="{x:Static local:Texts.SaveButton}" Command="{Binding SaveCommand}" />
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondary}"
               VerticalAlignment="Bottom" Margin="0,8" />

    <!-- Actions -->
    <Grid Grid.Row="4">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Style="{StaticResource SecondaryButton}"
                Content="{x:Static local:Texts.CommandPromptButton}" Command="{Binding StartCommandPromptCommand}" />
        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                Content="{x:Static local:Texts.HelperButton}" Command="{Binding StartHelperCommand}" />
      </StackPanel>
      <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" IsDefault="True"
              Content="{x:Static local:Texts.RecheckButton}" Command="{Binding RecheckCommand}" />
    </Grid>
  </Grid>
</Window>
