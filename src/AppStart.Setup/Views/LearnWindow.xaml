<Window x:Class="AppStart.Setup.Views.LearnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppStart.Setup.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LearnViewModel}"
        Title="{Binding Title}"
        Width="960" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextPrimary}">
  <!-- UI design docs/ui-designs/Learn.dc.html (add-allowed-child-processes) -->
  <Border Padding="28,20">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,24,0">
        <TextBlock Text="{x:Static vm:SetupTexts.LearnHeading}" Style="{StaticResource Heading}" />
        <TextBlock Text="{Binding Intro}" Style="{StaticResource Intro}" />
      </StackPanel>
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,8" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="{x:Static vm:SetupTexts.LearnEndsIn}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
          <TextBlock x:Name="Countdown" Text="{Binding Remaining}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                     AutomationProperties.Name="{x:Static vm:SetupTexts.LearnEndsIn}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,10" CornerRadius="4" Background="#FFF4CE">
      <TextBlock FontSize="13" TextWrapping="Wrap">
        <Run Text="{Binding WarningTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="#6B4E00" />
        <Run Text="{x:Static vm:SetupTexts.LearnWarningText}" />
      </TextBlock>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
      <StackPanel>
        <Grid Margin="12,8" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextSecondary}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Static vm:SetupTexts.LearnColumnPrograms}" />
          <TextBlock Grid.Column="1" Text="{x:Static vm:SetupTexts.LearnColumnStarts}" />
          <TextBlock Grid.Column="2" Text="{x:Static vm:SetupTexts.LearnColumnLast}" />
        </Grid>
        <Border Height="1" Background="{StaticResource HeaderDivider}" />
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Programs}" Focusable="False" AutomationProperties.Name="{x:Static vm:SetupTexts.LearnColumnPrograms}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:LearnProgramRow}">
                <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="12,9">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Exe}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Starts}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Last}" FontSize="13" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="{x:Static vm:SetupTexts.LearnNothingYet}" Margin="12,12" FontSize="13" Foreground="{StaticResource TextSecondary}"
                   Visibility="{Binding HasPrograms, Converter={StaticResource InverseBoolToVisibility}}" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource ErrorText}" FontSize="13" Text="{Binding ErrorMessage}"
               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource SecondaryButton}" Content="{x:Static vm:SetupTexts.ButtonLearnCancel}" Command="{Binding CancelCommand}" Padding="16,0" />
      <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonLearnFinish}" Command="{Binding FinishCommand}" Padding="16,0" />
    </StackPanel>
  </Grid>
  </Border>
</Window>
