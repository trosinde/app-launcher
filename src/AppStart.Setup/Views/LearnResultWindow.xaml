<Window x:Class="AppStart.Setup.Views.LearnResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppStart.Setup.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LearnResultViewModel}"
        Title="{Binding Title}"
        Width="960" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextPrimary}">
  <!-- UI design docs/ui-designs/LearnResult.dc.html (add-allowed-child-processes) -->
  <Border Padding="28,20">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{x:Static vm:SetupTexts.LearnResultHeading}" Style="{StaticResource Heading}" />
      <TextBlock Text="{Binding Intro}" Style="{StaticResource Intro}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
      <StackPanel>
        <Grid Margin="12,8" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextSecondary}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="230" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Text="{x:Static vm:SetupTexts.HelpersColumnProgram}" />
          <TextBlock Grid.Column="2" Text="{x:Static vm:SetupTexts.HelpersColumnCheck}" />
          <TextBlock Grid.Column="3" Text="{x:Static vm:SetupTexts.LearnResultColumnHint}" />
        </Grid>
        <Border Height="1" Background="{StaticResource HeaderDivider}" />
        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ProposalList" ItemsSource="{Binding Proposals}" Focusable="False"
                        AutomationProperties.Name="{x:Static vm:SetupTexts.LearnResultHeading}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:LearnProposal}">
                <Border x:Name="Row" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="12,10" Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsSelectable}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding FileName}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Exe}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Exe}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding CheckText}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock x:Name="HintText" Grid.Column="3" Text="{Binding Hint}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondary}" />
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HintIsWarning}" Value="True">
                    <Setter TargetName="HintText" Property="Foreground" Value="#6B4E00" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#FDF3F2" />
                    <Setter TargetName="HintText" Property="Foreground" Value="#9C1F17" />
                    <Setter TargetName="HintText" Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="{x:Static vm:SetupTexts.LearnResultNothing}" Margin="12,12" FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Text="{x:Static vm:SetupTexts.LearnResultFooter}" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource SecondaryButton}" Content="{x:Static vm:SetupTexts.ButtonDiscard}" Command="{Binding DiscardCommand}" />
      <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{Binding TakeOverText}" Command="{Binding TakeOverCommand}" Padding="16,0" />
    </StackPanel>
  </Grid>
  </Border>
</Window>
