<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:AppStart.Setup.Views">
  <!-- Colours and sizes from the UI designs docs/ui-designs/Main, Accounts, Summary and Verify.dc.html
       (same palette as the TestApp, src/AppStart.TestApp/App.xaml). -->
  <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3" />
  <SolidColorBrush x:Key="NavBackground" Color="#EAEEF3" />
  <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CardBorder" Color="#D6D6D6" />
  <SolidColorBrush x:Key="InputBorder" Color="#C4C4C4" />
  <SolidColorBrush x:Key="HeaderDivider" Color="#E0E0E0" />
  <SolidColorBrush x:Key="Divider" Color="#EEEEEE" />
  <SolidColorBrush x:Key="SelectedRow" Color="#E6F0FA" />
  <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
  <SolidColorBrush x:Key="TextSecondary" Color="#4A4A4A" />
  <SolidColorBrush x:Key="Primary" Color="#0F5299" />
  <SolidColorBrush x:Key="PrimaryHover" Color="#0A3A6E" />
  <SolidColorBrush x:Key="PrimaryDisabled" Color="#8FA9C7" />
  <SolidColorBrush x:Key="OkBackground" Color="#E3F2E6" />
  <SolidColorBrush x:Key="OkForeground" Color="#1E6B33" />
  <SolidColorBrush x:Key="OkCircle" Color="#1E7B34" />
  <SolidColorBrush x:Key="ErrorBackground" Color="#FBE9E7" />
  <SolidColorBrush x:Key="ErrorForeground" Color="#9C1F17" />
  <SolidColorBrush x:Key="ErrorStrong" Color="#B3261E" />
  <SolidColorBrush x:Key="DeviationRow" Color="#FDF3F2" />
  <SolidColorBrush x:Key="ChipBackground" Color="#EAEEF3" />
  <SolidColorBrush x:Key="IconPlaceholder" Color="#6B6B6B" />
  <SolidColorBrush x:Key="SignatureLine" Color="#1B1B1B" />

  <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <v:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
  <v:NullToVisibilityConverter x:Key="NullToVisibility" />
  <v:NullToVisibilityConverter x:Key="EmptyToVisibility" Invert="True" />
  <v:ExeIconConverter x:Key="ExeIcon" />

  <!-- Lock icon of the title bar, person and shield icons (24x24 viewbox, stroke 2 like the designs). -->
  <Geometry x:Key="LockGeometry">M5,10 L19,10 L19,20 L5,20 Z M8,10 V7 A4,4 0 0 1 16,7 V10</Geometry>
  <Geometry x:Key="PersonGeometry">M8,8 A4,4 0 1 0 16,8 A4,4 0 1 0 8,8 Z M4,21 C4,17 8,15 12,15 C16,15 20,17 20,21</Geometry>
  <Geometry x:Key="ShieldOkGeometry">M12,3 L20,6 V12 C20,17 16.5,20 12,21 C7.5,20 4,17 4,12 V6 Z M8.5,12 L11,14.5 L15.5,9.5</Geometry>
  <Geometry x:Key="ShieldWarnGeometry">M12,3 L20,6 V12 C20,17 16.5,20 12,21 C7.5,20 4,17 4,12 V6 Z M12,8 V13 M12,16 V16.5</Geometry>

  <Style x:Key="IconPath" TargetType="Path">
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="Stroke" Value="{StaticResource Primary}" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <Style x:Key="Intro" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>

  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>

  <Style x:Key="ErrorText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource ErrorForeground}" />
  </Style>

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{StaticResource OkBackground}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource OkForeground}" />
    <Setter Property="TextElement.FontSize" Value="12" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>

  <!-- Buttons: white with grey border (secondary) and filled blue (primary), as in the designs. -->
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="Background" Value="{StaticResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavBackground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#9A9A9A" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource Primary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inputs: 30 px high, grey border, 13 px text (designs: height 30, border #c4c4c4, padding 0 8). -->
</ResourceDictionary>
