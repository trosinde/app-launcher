<Window x:Class="AppStart.Setup.Views.HelpersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppStart.Setup.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:HelpersViewModel}"
        Title="{Binding Title}"
        Width="960" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextPrimary}">
  <!-- UI design docs/ui-designs/Helpers.dc.html (add-allowed-child-processes) -->
  <Border Padding="28,20">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{x:Static vm:SetupTexts.HelpersHeading}" Style="{StaticResource Heading}" />
      <TextBlock Text="{Binding Intro}" Style="{StaticResource Intro}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
      <StackPanel>
        <Grid Margin="12,8" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextSecondary}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="150" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Text="{x:Static vm:SetupTexts.HelpersColumnProgram}" />
          <TextBlock Grid.Column="2" Text="{x:Static vm:SetupTexts.HelpersColumnCheck}" />
          <TextBlock Grid.Column="3" Text="{x:Static vm:SetupTexts.HelpersColumnState}" />
        </Grid>
        <Border Height="1" Background="{StaticResource HeaderDivider}" />
        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="HelperList" ItemsSource="{Binding Items}" Focusable="False"
                        AutomationProperties.Name="{x:Static vm:SetupTexts.HelpersHeading}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:HelperItem}">
                <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="12,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding FileName}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Exe}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Exe}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding CheckText}" FontSize="13" VerticalAlignment="Center" />
                    <Border x:Name="StateBadge" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="4" Padding="8,3"
                            Background="#FFF4CE">
                      <TextBlock x:Name="StateText" Text="{Binding State}" FontSize="12" FontWeight="SemiBold" Foreground="#6B4E00" />
                    </Border>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding StateOk}" Value="True">
                    <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource OkBackground}" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource OkForeground}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border BorderBrush="{StaticResource HeaderDivider}" BorderThickness="0,1,0,0" Padding="12,10">
          <WrapPanel>
            <Button Style="{StaticResource SmallButton}" Content="{x:Static vm:SetupTexts.ButtonAddExe}" Command="{Binding AddExeCommand}" />
            <Button x:Name="LearnButton" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonLearnStart}"
                    Command="{Binding StartLearningCommand}" BorderBrush="{StaticResource Primary}" Foreground="{StaticResource Primary}" />
            <Button Style="{StaticResource SmallButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonRehash}" Command="{Binding RehashCommand}" />
            <Button Style="{StaticResource SmallButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonRemove}" Command="{Binding RemoveCommand}" />
          </WrapPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Margin="0,14,0,0" Padding="14,10" CornerRadius="4" Background="#FFF4CE"
            Visibility="{Binding UnsignedWarning, Converter={StaticResource NullToVisibility}}">
      <StackPanel>
        <TextBlock Text="{Binding UnsignedWarning}" FontSize="13" FontWeight="SemiBold" Foreground="#6B4E00" />
        <TextBlock Text="{x:Static vm:SetupTexts.HelpersUnsignedText}" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource ErrorText}" FontSize="13" Text="{Binding ErrorMessage}"
               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

    <TextBlock Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Text="{x:Static vm:SetupTexts.HelpersFooter}" />

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource SecondaryButton}" Content="{x:Static vm:SetupTexts.ButtonCancel}" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonApply}" Command="{Binding ApplyCommand}" />
    </StackPanel>
  </Grid>
  </Border>
</Window>
