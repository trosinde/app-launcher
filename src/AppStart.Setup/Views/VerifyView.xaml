<UserControl x:Class="AppStart.Setup.Views.VerifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppStart.Setup.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VerifyViewModel}"
             d:DesignWidth="960" d:DesignHeight="760"
             FontFamily="Segoe UI" FontSize="14"
             Foreground="{StaticResource TextPrimary}" Background="{StaticResource CardBackground}">
  <!-- UI design docs/ui-designs/Verify.dc.html (Prüfbericht) plus a button bar for print / save as. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <Grid Margin="40,36,40,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="18" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and deviation badge -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{x:Static vm:SetupTexts.VerifyKicker}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="{x:Static vm:SetupTexts.VerifyHeading}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1" CornerRadius="4" Padding="12,8" VerticalAlignment="Top" Margin="24,0,0,0"
                  Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ErrorBackground}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource ErrorForeground}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPassed}" Value="True">
                    <Setter Property="Background" Value="{StaticResource OkBackground}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource OkForeground}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding DeviationBadge}" FontSize="14" FontWeight="SemiBold" />
          </Border>
        </Grid>

        <!-- Meta data -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,0" TextElement.FontSize="13">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{x:Static vm:SetupTexts.MetaComputer}" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="{Binding Computer}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{x:Static vm:SetupTexts.MetaDate}" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="{Binding Date}" FontWeight="SemiBold" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{x:Static vm:SetupTexts.MetaTechnician}" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="{Binding Technician}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{x:Static vm:SetupTexts.MetaVersion}" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="{Binding Version}" FontWeight="SemiBold" Margin="0,2,0,0" />
          </StackPanel>
        </UniformGrid>

        <!-- Table: check point / target / result -->
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
          <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,2" Padding="10,8">
            <Grid TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextSecondary}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static vm:SetupTexts.ColumnCheck}" />
              <TextBlock Grid.Column="1" Text="{x:Static vm:SetupTexts.ColumnExpected}" Margin="10,0,0,0" />
              <TextBlock Grid.Column="2" Text="{x:Static vm:SetupTexts.ColumnResult}" Margin="10,0,0,0" />
            </Grid>
          </Border>
          <TextBlock Text="{x:Static vm:SetupTexts.VerifyRunning}" Margin="10,12" Foreground="{StaticResource TextSecondary}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="{x:Static vm:SetupTexts.VerifyKicker}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:CheckRow}">
                <Border x:Name="Row" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="10,9">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Title" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Expected" Grid.Column="1" Text="{Binding Text}" Margin="10,0,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondary}" />
                    <Border x:Name="Badge" Grid.Column="2" Margin="10,0,0,0" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Background="{StaticResource OkBackground}">
                      <TextBlock x:Name="BadgeText" Text="{Binding ResultText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OkForeground}" />
                    </Border>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsDeviation}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource DeviationRow}" />
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Expected" Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource ErrorStrong}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="White" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Deviation box (red) or passed box (green) -->
        <StackPanel Grid.Row="3">
          <Border Margin="0,18,0,0" CornerRadius="4" Padding="16,12" Background="{StaticResource ErrorBackground}"
                  Visibility="{Binding HasDeviations, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="{x:Static vm:SetupTexts.DeviationBoxTitle}" FontWeight="SemiBold" Foreground="{StaticResource ErrorForeground}" />
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                <Run Text="{x:Static vm:SetupTexts.DeviationBoxText}" />
                <Run Text="{x:Static vm:SetupTexts.VerifyCommand}" FontFamily="Consolas" FontSize="13" />
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Margin="0,18,0,0" CornerRadius="4" Padding="16,12" Background="{StaticResource OkBackground}"
                  Visibility="{Binding IsPassed, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="{x:Static vm:SetupTexts.PassedBoxTitle}" FontWeight="SemiBold" Foreground="{StaticResource OkForeground}" />
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding PassedText, Mode=OneWay}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Signature lines -->
        <Grid Grid.Row="5" Margin="0,24,0,0" TextElement.FontSize="13" TextElement.Foreground="{StaticResource TextSecondary}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border BorderBrush="{StaticResource SignatureLine}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
            <TextBlock Text="{x:Static vm:SetupTexts.SignatureTechnician}" />
          </Border>
          <Border Grid.Column="2" BorderBrush="{StaticResource SignatureLine}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
            <TextBlock Text="{x:Static vm:SetupTexts.SignatureCustomer}" />
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <!-- Button bar -->
    <Border Grid.Row="1" Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource HeaderDivider}" BorderThickness="0,1,0,0" Padding="40,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                     ToolTip="{Binding StatusText}" Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}" />
          <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}"
                     Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource SecondaryButton}" Content="{x:Static vm:SetupTexts.ButtonRepeat}" Command="{Binding RepeatCommand}" />
          <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonSaveAs}" Command="{Binding SaveAsCommand}" />
          <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonPrint}" Command="{Binding PrintCommand}" />
          <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonClose}" Command="{Binding CloseCommand}" IsCancel="True" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
