<UserControl x:Class="AppStart.Setup.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppStart.Setup.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WizardViewModel}"
             d:DesignWidth="960" d:DesignHeight="600"
             FontFamily="Segoe UI" FontSize="14"
             Foreground="{StaticResource TextPrimary}" Background="{StaticResource WindowBackground}">
  <!-- UI designs docs/ui-designs/Main.dc.html (1/3), Accounts.dc.html (2/3), Summary.dc.html (3/3). -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation: active step highlighted, done steps with ✓ -->
    <Border Background="{StaticResource NavBackground}" Padding="16,24">
      <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" AutomationProperties.Name="Steps">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:StepItem}">
            <Border x:Name="Bd" Padding="12,10" Margin="0,0,0,6" CornerRadius="4" Background="Transparent">
              <TextBlock x:Name="Txt" Text="{Binding DisplayText}" FontSize="14" Foreground="{StaticResource TextSecondary}" />
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBackground}" />
                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Primary}" />
                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Grid Grid.Column="1" Margin="28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============================================================ Step 1: applications -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsAppsStep, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="{x:Static vm:SetupTexts.AppsHeading}" Style="{StaticResource Heading}" />
          <TextBlock Text="{x:Static vm:SetupTexts.AppsIntro}" Style="{StaticResource Intro}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <Grid Margin="12,8" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextSecondary}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="2" Text="{x:Static vm:SetupTexts.AppsColumnApp}" />
              <TextBlock Grid.Column="3" Text="{x:Static vm:SetupTexts.AppsColumnCheck}" />
              <TextBlock Grid.Column="4" Text="{x:Static vm:SetupTexts.AppsColumnChildren}" />
            </Grid>
            <Border Height="1" Background="{StaticResource HeaderDivider}" />

            <ListBox x:Name="AppList" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
                     MaxHeight="168" BorderThickness="0" Padding="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{x:Static vm:SetupTexts.AppsColumnApp}">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="12,8">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=PreviousData}}" Value="{x:Null}">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0" />
                          </DataTrigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F8FC" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedRow}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Name}" />
                    <Grid Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Left">
                      <Border x:Name="Placeholder" Background="{StaticResource IconPlaceholder}" CornerRadius="4" />
                      <Image x:Name="Icon" Source="{Binding ExePath, Converter={StaticResource ExeIcon}}" Width="28" Height="28"
                             RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ExePath}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding CheckText}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock x:Name="Children" Grid.Column="4" Text="{Binding ChildSummary}" FontSize="13" VerticalAlignment="Center" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Source, ElementName=Icon, Converter={StaticResource NullToVisibility}}" Value="Visible">
                      <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ChildMode}" Value="Blocked">
                      <Setter TargetName="Children" Property="Foreground" Value="{StaticResource TextSecondary}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{x:Static vm:SetupTexts.AppsEmpty}" Margin="12,14" FontSize="13" Foreground="{StaticResource TextSecondary}"
                       TextWrapping="Wrap" Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVisibility}}" />

            <Border BorderBrush="{StaticResource HeaderDivider}" BorderThickness="0,1,0,0" Padding="12,10">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SmallButton}" Content="{x:Static vm:SetupTexts.ButtonAddExe}" Command="{Binding AddExeCommand}" />
                <Button Style="{StaticResource SmallButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonRemove}" Command="{Binding RemoveAppCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Protection of the selected application -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10"
                DataContext="{Binding SelectedApp}"
                Visibility="{Binding Converter={StaticResource NullToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding ProtectionHeading}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="{x:Static vm:SetupTexts.ProtectionExplanation}" Style="{StaticResource Hint}" Margin="0,0,0,10" />
            <Grid TextElement.FontSize="13">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Label Content="{x:Static vm:SetupTexts.DataDirLabel}" Target="{Binding ElementName=DataDirBox}" Padding="0" FontSize="13" VerticalAlignment="Center" />
              <TextBox x:Name="DataDirBox" Grid.Column="1" Height="30" MinHeight="30" FontSize="13" Padding="6,0" VerticalContentAlignment="Center"
                       Text="{Binding DataDir, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource SmallButton}" Height="30" Padding="6,0"
                      Content="{x:Static vm:SetupTexts.ButtonBrowse}"
                      Command="{Binding DataContext.BrowseDataDirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                <TextBlock Style="{StaticResource ErrorText}" Margin="0,4,0,0"
                           Text="{Binding DataDirError}" Visibility="{Binding DataDirError, Converter={StaticResource NullToVisibility}}" />
                <!-- spec fix-wizard-findings: data folder in the program folder -->
                <Border Style="{StaticResource WarningBox}" Margin="0,8,0,0"
                        Visibility="{Binding DataDirInProgramFolder, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel>
                    <TextBlock Text="{x:Static vm:SetupTexts.DataDirInProgramFolderWarning}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource WarningForeground}" AutomationProperties.LiveSetting="Assertive" />
                    <CheckBox Margin="0,8,0,0" FontSize="13" IsChecked="{Binding DataDirRiskAccepted}"
                              Content="{x:Static vm:SetupTexts.DataDirAcceptRisk}" Foreground="{StaticResource WarningForeground}" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <Label Grid.Row="2" Content="{x:Static vm:SetupTexts.RegistryKeyLabel}" Target="{Binding ElementName=RegistryKeyBox}" Padding="0" FontSize="13"
                     VerticalAlignment="Center" Margin="0,8,0,0" />
              <TextBox x:Name="RegistryKeyBox" Grid.Row="2" Grid.Column="1" Height="30" MinHeight="30" FontSize="13" Padding="6,0" VerticalContentAlignment="Center" Margin="0,8,0,0"
                       Text="{Binding RegistryKey, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,8,0,0" VerticalAlignment="Center" Style="{StaticResource Hint}"
                         Text="{x:Static vm:SetupTexts.RegistryKeyNote}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}" Margin="0,4,0,0"
                         Text="{Binding RegistryKeyError}" Visibility="{Binding RegistryKeyError, Converter={StaticResource NullToVisibility}}" />
              <!-- add-allowed-child-processes: "Other programs" (docs/ui-designs/Main.dc.html) -->
              <Label Grid.Row="4" Content="{x:Static vm:SetupTexts.ChildrenLabel}" Target="{Binding ElementName=ChildModeBox}" Padding="0" FontSize="13"
                     VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox x:Name="ChildModeBox" Grid.Row="4" Grid.Column="1" Height="30" FontSize="13" Margin="0,8,0,0" VerticalContentAlignment="Center"
                        ItemsSource="{Binding ChildModeOptions}" SelectedIndex="{Binding ChildModeIndex}"
                        AutomationProperties.Name="{x:Static vm:SetupTexts.ChildrenLabel}" />
              <Button x:Name="HelpersButton" Grid.Row="4" Grid.Column="2" Margin="10,8,0,0" Style="{StaticResource SmallButton}" Height="30" Padding="6,0"
                      Content="{Binding HelpersButtonText}"
                      Command="{Binding DataContext.OpenHelpersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Visibility="{Binding IsAllowlist, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Text="{Binding ChildHint}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource ErrorText}" Text="{Binding ChildError}"
                       Visibility="{Binding ChildError, Converter={StaticResource NullToVisibility}}" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,4,0,0">
          <TextBlock Style="{StaticResource ErrorText}" FontSize="13" Text="{Binding ErrorMessage}"
                     Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
          <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="{Binding AppsHint}"
                     Visibility="{Binding AppsHint, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
      </Grid>
      </ScrollViewer>

      <!-- ============================================================ Step 2: accounts and group -->
      <StackPanel Visibility="{Binding IsAccountsStep, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{x:Static vm:SetupTexts.AccountsHeading}" Style="{StaticResource Heading}" />
        <TextBlock Text="{x:Static vm:SetupTexts.AccountsIntro}" Style="{StaticResource Intro}" />

        <!-- Administrators without password (spec fix-wizard-findings) -->
        <Border Style="{StaticResource WarningBox}" Margin="0,14,0,0"
                Visibility="{Binding AdminPasswordWarning, Converter={StaticResource NullToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Viewbox Width="22" Height="22" VerticalAlignment="Top">
              <Path Style="{StaticResource IconPath}" Stroke="{StaticResource WarningForeground}" Data="{StaticResource ShieldWarnGeometry}" />
            </Viewbox>
            <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding AdminPasswordWarning}" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource WarningForeground}" AutomationProperties.LiveSetting="Assertive" />
          </Grid>
        </Border>

        <!-- App account (always automatic) -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Viewbox Width="28" Height="28" VerticalAlignment="Top">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource PersonGeometry}" />
            </Viewbox>
            <StackPanel Grid.Column="1" Margin="14,0,14,0">
              <TextBlock Text="{x:Static vm:SetupTexts.AppAccountTitle}" Style="{StaticResource CardTitle}" />
              <TextBlock Text="{Binding AppAccountText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Badge}">
              <TextBlock Text="{x:Static vm:SetupTexts.BadgeAutomatic}" />
            </Border>
          </Grid>
        </Border>

        <!-- Operator account appstart-user -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
          <StackPanel>
            <StackPanel Visibility="{Binding ShowCreateOperator, Converter={StaticResource BoolToVisibility}}">
              <CheckBox x:Name="CreateOperatorBox" IsChecked="{Binding CreateOperatorAccount}" MinWidth="0" FontSize="14" FontWeight="SemiBold"
                        Content="{x:Static vm:SetupTexts.CreateOperatorAccount}" VerticalContentAlignment="Center" />
              <Grid Margin="28,10,0,0" TextElement.FontSize="13"
                    Visibility="{Binding CreateOperatorAccount, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="{x:Static vm:SetupTexts.PasswordLabel}" Target="{Binding ElementName=PasswordBox1}" Padding="0" FontSize="13" VerticalAlignment="Center" />
                <PasswordBox x:Name="PasswordBox1" Grid.Column="1" Height="30" MinHeight="30" FontSize="13" Padding="6,0" VerticalContentAlignment="Center" PasswordChanged="OnPasswordChanged" />
                <Label Grid.Row="1" Content="{x:Static vm:SetupTexts.PasswordConfirmLabel}" Target="{Binding ElementName=PasswordBox2}" Padding="0" FontSize="13"
                       VerticalAlignment="Center" Margin="0,8,0,0" />
                <PasswordBox x:Name="PasswordBox2" Grid.Row="1" Grid.Column="1" Height="30" MinHeight="30" FontSize="13" Padding="6,0" VerticalContentAlignment="Center" Margin="0,8,0,0"
                             PasswordChanged="OnPasswordConfirmChanged" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ErrorText}" Margin="0,4,0,0"
                           Text="{Binding PasswordError}" Visibility="{Binding PasswordError, Converter={StaticResource NullToVisibility}}" />
              </Grid>
            </StackPanel>
            <Grid Visibility="{Binding OperatorAccountExists, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{x:Static vm:SetupTexts.OperatorAccountExisting}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
              <Border Style="{StaticResource Badge}" HorizontalAlignment="Right">
                <TextBlock Text="{x:Static vm:SetupTexts.BadgeExisting}" />
              </Border>
            </Grid>
            <TextBlock Margin="28,10,0,0" Style="{StaticResource Hint}" Text="{x:Static vm:SetupTexts.OperatorAccountNote}" />
          </StackPanel>
        </Border>

        <!-- Further members of AppStart Users -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
          <StackPanel>
            <TextBlock Text="{x:Static vm:SetupTexts.MembersHeading}" Style="{StaticResource CardTitle}" />
            <ItemsControl ItemsSource="{Binding Members}" Focusable="False" Margin="0,2,0,0"
                          AutomationProperties.Name="{x:Static vm:SetupTexts.MembersHeading}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MemberItem}">
                  <Border Background="{StaticResource ChipBackground}" CornerRadius="4" Padding="10,6" Margin="0,8,8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Account}" FontSize="13" VerticalAlignment="Center" />
                      <Button Content="✕" FontSize="11" Margin="8,0,0,0" Padding="2,0" Cursor="Hand"
                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                              ToolTip="{x:Static vm:SetupTexts.RemoveMember}" AutomationProperties.Name="{x:Static vm:SetupTexts.RemoveMember}"
                              Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <ContentPresenter VerticalAlignment="Center" />
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="MemberBox" Height="30" MinHeight="30" FontSize="13" Padding="6,0" VerticalContentAlignment="Center" Text="{Binding NewMember, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{x:Static vm:SetupTexts.MemberInputName}" KeyDown="OnMemberKeyDown" />
              <TextBlock Text="{x:Static vm:SetupTexts.MemberPlaceholder}" IsHitTestVisible="False" Margin="10,0,0,0" FontSize="13"
                         VerticalAlignment="Center" Foreground="#8A8A8A"
                         Visibility="{Binding NewMember, Converter={StaticResource EmptyToVisibility}}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                      Content="{x:Static vm:SetupTexts.ButtonAddMember}" Command="{Binding AddMemberCommand}" />
            </Grid>
            <TextBlock Style="{StaticResource ErrorText}" Margin="0,4,0,0" Text="{Binding MemberError}"
                       Visibility="{Binding MemberError, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{x:Static vm:SetupTexts.MembersRemoveNote}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ============================================================ Step 3: summary and check -->
      <StackPanel Visibility="{Binding IsSummaryStep, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding SummaryHeading}" Style="{StaticResource Heading}" />
        <TextBlock Text="{Binding SummaryIntro}" Style="{StaticResource Intro}" />

        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="4" />
          <TextBlock Text="{Binding ProgressText}" FontSize="13" Margin="0,8,0,0" Foreground="{StaticResource TextSecondary}" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
          <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}" Focusable="False" AutomationProperties.Name="{x:Static vm:SetupTexts.NavSummary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ResultLine}">
                  <Border x:Name="Row" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="14,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border x:Name="Circle" Width="22" Height="22" CornerRadius="11" Background="{StaticResource OkCircle}" VerticalAlignment="Top">
                        <TextBlock x:Name="Mark" Text="✓" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=PreviousData}}" Value="{x:Null}">
                      <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Success}" Value="False">
                      <Setter TargetName="Circle" Property="Background" Value="{StaticResource ErrorStrong}" />
                      <Setter TargetName="Mark" Property="Text" Value="✗" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- Verify result: green when passed, red with the number of deviations -->
        <Border Margin="0,14,0,0" CornerRadius="4" Padding="16,14"
                Visibility="{Binding HasVerifyResult, Converter={StaticResource BoolToVisibility}}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{StaticResource ErrorBackground}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding VerifyPassed}" Value="True">
                  <Setter Property="Background" Value="{StaticResource OkBackground}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Viewbox Width="28" Height="28" VerticalAlignment="Center">
              <Path>
                <Path.Style>
                  <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                    <Setter Property="Stroke" Value="{StaticResource ErrorForeground}" />
                    <Setter Property="Data" Value="{StaticResource ShieldWarnGeometry}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding VerifyPassed}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource OkForeground}" />
                        <Setter Property="Data" Value="{StaticResource ShieldOkGeometry}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Viewbox>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding VerifyText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource ErrorForeground}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding VerifyPassed}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource OkForeground}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding ReportText}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                         Visibility="{Binding ReportText, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <!-- ============================================================ Buttons -->
      <Button Grid.Row="1" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource SecondaryButton}"
              Content="{x:Static vm:SetupTexts.ButtonVerifySetup}" Command="{Binding OpenVerifyCommand}"
              Visibility="{Binding IsAppsStep, Converter={StaticResource BoolToVisibility}}" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Style="{StaticResource SecondaryButton}" Content="{x:Static vm:SetupTexts.ButtonCancel}" Command="{Binding CancelCommand}" IsCancel="True"
                Visibility="{Binding IsAppsStep, Converter={StaticResource BoolToVisibility}}" />
        <Button Style="{StaticResource SecondaryButton}" Content="{x:Static vm:SetupTexts.ButtonBack}" Command="{Binding BackCommand}"
                Visibility="{Binding IsAccountsStep, Converter={StaticResource BoolToVisibility}}" />
        <Button Style="{StaticResource SecondaryButton}" Content="{x:Static vm:SetupTexts.ButtonOpenReport}" Command="{Binding OpenReportCommand}"
                Visibility="{Binding HasReportPath, Converter={StaticResource BoolToVisibility}}" />
        <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonNext}" Command="{Binding NextCommand}" IsDefault="True"
                Visibility="{Binding IsSummaryStep, Converter={StaticResource InverseBoolToVisibility}}" />
        <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{x:Static vm:SetupTexts.ButtonFinish}" Command="{Binding FinishCommand}"
                Visibility="{Binding IsSummaryStep, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
